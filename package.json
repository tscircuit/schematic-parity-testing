{
  "name": "@tscircuit/schematic-parity-testing",
  "version": "1.0.0",
  "description": "Visual parity tests for a tscircuit recreation of TI TIDA-010076",
  "main": "index.circuit.tsx",
  "private": true,
  "keywords": [
    "tscircuit",
    "circuit",
    "pcb",
    "electronics"
  ],
  "scripts": {
    "dev": "tsci dev",
    "build": "tsci build index.circuit.tsx --disable-pcb --routing-disabled --disable-parts-engine --schematic-svgs --ignore-warnings",
    "build:schematic": "tsci build index.circuit.tsx --disable-pcb --routing-disabled --disable-parts-engine --ignore-warnings",
    "generate": "node scripts/generate-design-data.mjs",
    "render:ti": "bun scripts/render-ti-pages.ts",
    "snapshot": "tsci snapshot",
    "snapshot:update": "tsci snapshot --update",
    "start": "tsci dev",
    "test": "bun test tests",
    "test:update": "bun test tests --update-snapshots",
    "test:visual": "bun run build:schematic && bun test tests",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/react": "latest",
    "bun-match-svg": "0.0.17",
    "circuit-to-svg": "^0.0.407",
    "looks-same": "^10.0.1",
    "sharp": "^0.35.3",
    "stack-svgs": "0.0.1",
    "tscircuit": "latest",
    "typescript": "^5.0.0"
  },
  "author": "tscircuit"
}
